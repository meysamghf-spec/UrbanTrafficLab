# Copy to .env and adjust. Do not commit a real .env file.
# The application reads UTL_* variables on the server only.

UTL_DATABASE_URL=sqlite:///./data/urbantrafficlab.db
UTL_CORS_ORIGINS=http://localhost:3000
UTL_LOG_LEVEL=INFO

# Leave the language model unset. Supported commands still parse with the rule-based parser.
UTL_LLM_PROVIDER=none
UTL_LLM_API_KEY=
UTL_LLM_BASE_URL=
UTL_LLM_MODEL=
UTL_LLM_TIMEOUT_S=30
UTL_LLM_MAX_RETRIES=2

# Empty values mean "discover sumo and netconvert on PATH".
UTL_SUMO_BINARY=
UTL_SUMO_HOME=
UTL_SIMULATION_TIMEOUT_S=120
UTL_SIMULATION_END_BUFFER_S=900
UTL_MAX_VEHICLES=5000
UTL_SYNC_JOBS=0

UTL_OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
UTL_OSM_TIMEOUT_S=25
UTL_OSM_MAX_RETRIES=1
UTL_OSM_MAX_SPAN_DEGREES=0.2
UTL_CACHE_DIR=./data/cache

# Optional raster tile template, for example https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Leave empty to draw the network on a plain background. Tile use is your responsibility.
UTL_MAP_TILE_URL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=
